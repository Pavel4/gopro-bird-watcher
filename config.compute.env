# Конфигурация для Compute Server (PC/Mac)
# Роль: ML-инференс через gRPC
#
# Запуск:
#   ./run-native.sh --role compute
#   или: python detector/inference_server.py

# === GRPC СЕРВЕР ===
# Порт для приёма запросов от edge-устройств
GRPC_SERVER_PORT=50051

# === ML РАСПОЗНАВАНИЕ ПТИЦ ===
ML_ENABLED=true
ML_MODEL_DIR=./models
ML_CONFIDENCE_THRESHOLD=0.5
ML_SPECIES_ENABLED=true

# === ML РАСПОЗНАВАНИЕ ПОВЕДЕНИЯ ===
ML_BEHAVIOR_ENABLED=false
ML_BEHAVIOR_NUM_FRAMES=8
ML_BEHAVIOR_CONFIDENCE=0.4

# === ПРИМЕЧАНИЯ ===
# 1. Compute-сервер не работает с камерой,
#    не пишет видео, не отправляет в Telegram.
#    Только ML-инференс.
#
# 2. Модели автозагружаются при первом запуске:
#    - YOLOv8n ONNX (~13 MB)
#    - CLIP visual + head нужно обучить:
#      python scripts/train_species_classifier.py
#
# 3. GPU ускорение:
#    - NVIDIA: pip install onnxruntime-gpu
#    - Mac M-series: onnxruntime автоматически
#      использует CoreML
#    - CPU: работает из коробки (медленнее)
#
# 4. Проверка доступных провайдеров:
#    python -c "import onnxruntime as ort; \
#      print(ort.get_available_providers())"
